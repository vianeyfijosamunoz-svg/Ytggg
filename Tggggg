end

local cachedMeleeTables = {}
local meleeCacheInitialized = false
local function cacheMeleeTables()
    if meleeCacheInitialized then return end
    meleeCacheInitialized = true
    task.spawn(function()
        pcall(function()
            if getgc then
                for _, gcVal in pairs(getgc(true)) do
                    if type(gcVal) == "table" then
                        if rawget(gcVal, "MeleeCooldown") or rawget(gcVal, "SwingCooldown") or rawget(gcVal, "SlashCooldown") or rawget(gcVal, "AttackCooldown") or rawget(gcVal, "HitCooldown") then
                            table.insert(cachedMeleeTables, gcVal)
                        end
                    end
                end
            end
        end)
    end)
end

local function EnableFastMelee(state)
    if state then
        cacheMeleeTables()
        pcall(function()
            for _, gcVal in ipairs(cachedMeleeTables) do
                if rawget(gcVal, "MeleeCooldown") then gcVal.MeleeCooldown = 0 end
                if rawget(gcVal, "SwingCooldown") then gcVal.SwingCooldown = 0 end
                if rawget(gcVal, "SlashCooldown") then gcVal.SlashCooldown = 0 end
                if rawget(gcVal, "AttackCooldown") then gcVal.AttackCooldown = 0 end
                if rawget(gcVal, "HitCooldown") then gcVal.HitCooldown = 0 end
            end
        end)
    end
end

