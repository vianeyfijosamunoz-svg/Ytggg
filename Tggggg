local function toggleTableAttribute(attr, val)
    if getgc then
        for _, gcVal in pairs(getgc(true)) do
            if type(gcVal) == "table" and rawget(gcVal, attr) then gcVal[attr] = val end
        end
    end
end

local function EnableRapidFire(state)
