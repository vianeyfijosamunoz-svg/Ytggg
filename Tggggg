    end

    if getgenv().SpinbotEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(getgenv().SpinbotSpeed), 0)
    end
end)

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end

    if getgenv().UndergroundEnabled then
        hrp.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - 5, hrp.Position.Z)
    end

    if getgenv().HipHeightEnabled then
        hum.HipHeight = getgenv().HipHeightValue
    end

    if getgenv().CharTransparencyEnabled then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.Transparency = getgenv().CharTransparencyValue
            elseif part:IsA("Decal") then
                part.Transparency = getgenv().CharTransparencyValue
            end
        end
    end

    if getgenv().NoCollisionEnabled then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    if getgenv().GravityEnabled then
        workspace.Gravity = getgenv().GravityValue
    else
        workspace.Gravity = defaultGravity
    end

    if getgenv().SpeedBoostEnabled then
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude > 0 then
            hrp.AssemblyLinearVelocity = Vector3.new(
                moveDir.X * getgenv().SpeedBoostValue,
                hrp.AssemblyLinearVelocity.Y,
                moveDir.Z * getgenv().SpeedBoostValue
            )
        end
    end
end)

local lastAutoQueue = 0
local lastLoadout = 0
local lastAntiAFK = 0

task.spawn(function()
    while true do
        task.wait(0.5)
        if getgenv().AutoQueueEnabled then
            local now = tick()
            if now - lastAutoQueue > 8 then
                lastAutoQueue = now
                pcall(function()
                    game:GetService("TeleportService"):Teleport(game.PlaceId, LocalPlayer)
                end)
            end
        end
        if getgenv().AutoLoadoutEnabled then
            local now = tick()
            if now - lastLoadout > 4 then
                lastLoadout = now
                pcall(function()
                    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                    if remotes then
                        local loadoutRemote = remotes:FindFirstChild("Loadout") or remotes:FindFirstChild("EquipLoadout") or remotes:FindFirstChild("SetLoadout")
                        if loadoutRemote and loadoutRemote:IsA("RemoteEvent") then
                            loadoutRemote:FireServer(1)
                        end
                    end
                end)
            end
        end
        if getgenv().AutoRespawnEnabled then
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then
                pcall(function()
                    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                    if remotes then
                        local respawn = remotes:FindFirstChild("Respawn") or remotes:FindFirstChild("RequestRespawn")
                        if respawn then respawn:FireServer() end
                    end
                    if LocalPlayer.Character then LocalPlayer.Character:BreakJoints() end
                end)
            end
        end
        if getgenv().AntiAFKEnabled then
            local now = tick()
            if now - lastAntiAFK > 30 then
                lastAntiAFK = now
                pcall(function()
                    local vim = game:GetService("VirtualUser")
                    vim:CaptureController()
                    vim:ClickButton2(Vector2.new())
                end)
            end
        end
    end
end)

